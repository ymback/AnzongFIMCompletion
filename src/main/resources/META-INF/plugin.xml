<idea-plugin>
    <id>gov.anzong.fim.completion</id>
    <name>AnzongFIMCompletion</name>
    <vendor email="webmaster@myauth.us" url="https://myauth.us">Shiori Takei</vendor>
    <description><![CDATA[
    <b>AnzongFIM</b> brings private, lightning-fast AI code completion to your JetBrains IDE.
    Features <b>Local LLM FIM (Fill-in-the-Middle)</b> inline assistance powered by Ollama,
    enhanced with <b>Multi-File Context</b> awareness to keep your code secure and your workflow seamless.
]]></description>

    <!-- 兼容 2024.2 (242) 到未来的所有版本 -->
    <idea-version since-build="242.0" until-build="999.*"/>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="gov.anzong.fim.completion.settings.AnzongSettingsState"/>
        <applicationConfigurable parentId="tools"
                                 instance="gov.anzong.fim.completion.settings.AnzongSettingsConfigurable"
                                 id="gov.anzong.fim.completion.settings.AnzongSettingsConfigurable"
                                 displayName="Anzong FIM Completion"/>


        <inline.completion.provider implementation="gov.anzong.fim.completion.provider.AnzongFIMCompletionProvider"
                                    id="AnzongFIM"/>

        <postStartupActivity implementation="gov.anzong.fim.completion.startup.ForceDisableBuiltInCompletionActivity"/>
    </extensions>
</idea-plugin>